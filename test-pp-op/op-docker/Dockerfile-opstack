FROM golang:1.24 as builder
WORKDIR /app

ARG TARGETARCH

RUN apt-get update && apt-get install -y curl git jq

RUN case ${TARGETARCH} in \
        "amd64") JUST_ARCH="x86_64" ;; \
        "arm64") JUST_ARCH="aarch64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -sSL "https://github.com/casey/just/releases/download/1.36.0/just-1.36.0-${JUST_ARCH}-unknown-linux-musl.tar.gz" | tar -xz -C /usr/local/bin just && \
    chmod +x /usr/local/bin/just


RUN apt-get install -y nodejs npm && \
curl -L https://foundry.paradigm.xyz | bash && \
/root/.foundry/bin/foundryup && \
mv /root/.foundry/bin/* /usr/local/bin/ && \
apt-get clean && rm -rf /var/lib/apt/lists/* /root/.foundry

COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Build op-program first
RUN make op-program

# Build cannon
RUN make cannon

# Generate prestate files
RUN make cannon-prestate || echo "cannon-prestate failed, trying alternative approach"

# build op-challenger
RUN make op-challenger

# Build everything else
RUN make build